---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const all = await getCollection('reviews', (r) => !r.data.draft);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const when = d.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.summary}>
  <article>
    <h1>{d.title}</h1>
    <p class="note">Problem it targets: {d.problem}. Tested {when}. I’m an affiliate for this tool. <a href="/affiliate-disclosure/">What that means</a>.</p>
    <Content />
    <div class="verdict">
      <div><h2>This is for you if…</h2><ul>{d.forYou.map((i) => <li>{i}</li>)}</ul></div>
      <div class="not"><h2>This is not for you if…</h2><ul>{d.notForYou.map((i) => <li>{i}</li>)}</ul></div>
    </div>
    {d.affiliateUrl && <p><a class="btn" href={d.affiliateUrl} rel="sponsored noopener">Try it yourself</a></p>}
  </article>
</Base>
