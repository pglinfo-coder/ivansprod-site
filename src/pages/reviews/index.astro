---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('reviews', (r) => !r.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = [...new Set(all.map((r) => r.data.problem))];
---
<Base title="Reviews" description="Tool reviews sorted by the problem you want to solve.">
  <h1>Reviews, sorted by the problem you want to solve</h1>
  {all.length === 0 && <p>The first reviews are on their way.</p>}
  {groups.map((g) => (
    <section>
      <h2>{g}</h2>
      <ul class="list">
        {all.filter((r) => r.data.problem === g).map((r) => (
          <li><a href={`/reviews/${r.id}/`}>{r.data.title}</a><p>{r.data.summary}</p></li>
        ))}
      </ul>
    </section>
  ))}
</Base>
