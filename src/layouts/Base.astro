---
import '../styles/global.css';
const { title, description = 'Honest, hands-on reviews of AI tools for solo business owners.' } = Astro.props;
const full = title === 'Ivan’s Prod' ? title : `${title} | Ivan’s Prod`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{full}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#17594A">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
</head>
<body>
  <header class="site"><div class="wrap">
    <a class="brand" href="/"><svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="14" fill="#17594A"/><path d="M32 9 C22 9 16 16 16 24 C16 30 19 33 22 37 C23.5 39 24 41 24 43 L40 43 C40 41 40.5 39 42 37 C45 33 48 30 48 24 C48 16 42 9 32 9 Z" fill="#FFFFFF"/><rect x="25" y="46" width="14" height="4" rx="2" fill="#BFE6D3"/><rect x="27.5" y="52" width="9" height="3" rx="1.5" fill="#BFE6D3"/><path d="M24 25 L30 31 L40 19" fill="none" stroke="#17594A" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Ivan’s <span class="prod">Prod</span></span></a>
    <nav><a href="/reviews/">Reviews</a><a href="/about/">About</a></nav>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer class="site"><div class="wrap">
    <a href="/contact/">Contact</a><a href="/privacy/">Privacy policy</a><a href="/affiliate-disclosure/">Affiliate disclosure</a>
    <p>Real tests. Honest verdicts.</p>
  </div></footer>
</body>
</html>
